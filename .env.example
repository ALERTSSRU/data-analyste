# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
#
# Both variables are required for the site to read live content from the
# database and for /admin to be reachable. Without them the app still builds
# and runs, but every page falls back to the static demo data declared in
# lib/portfolio.ts (and /admin shows a "not configured" notice).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Absolute site URL, used for canonical links / metadata.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Service role key: server-side only, NEVER expose it with a NEXT_PUBLIC_ prefix.
# Only needed for maintenance scripts that bypass Row Level Security.
# SUPABASE_SERVICE_ROLE_KEY=
